# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Resend (Email API)
RESEND_API_KEY=re_xxxxx
RESEND_FROM_EMAIL=noreply@yourdomain.com

# Cakto Payment Gateway
CAKTO_CLIENT_ID=your_cakto_client_id
CAKTO_CLIENT_SECRET=your_cakto_client_secret
CAKTO_OFFER_MONTHLY_ID=your_monthly_offer_id
CAKTO_OFFER_ANNUAL_ID=your_annual_offer_id
CAKTO_WEBHOOK_SECRET=your_webhook_secret_from_cakto_dashboard

# Admin
ADMIN_EMAIL=seu-email@dominio.com.br



# Daily digest (Vercel Cron). Any long random value.
CRON_SECRET=generate-a-long-random-value

# Signs the one-click unsubscribe links. Any long random value. Falls back to CRON_SECRET.
EMAIL_UNSUBSCRIBE_SECRET=generate-a-long-random-value

# Responsável pelo site (Decreto 7.962/2013). Aparecem publicamente. Nunca coloque valores reais neste arquivo.
EMPRESA_NOME=Nome completo ou razao social
EMPRESA_DOCUMENTO=CPF ou CNPJ
EMPRESA_ENDERECO=Rua, numero, bairro, cidade, UF, CEP
EMPRESA_ENCARREGADO=
